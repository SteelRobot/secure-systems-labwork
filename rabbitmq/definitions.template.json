{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "exchanges": [
    {
      "name": "app.events",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "app.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "audit",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 5,
        "x-dead-letter-exchange": "app.dlx",
        "x-dead-letter-routing-key": "audit"
      }
    },
    {
      "name": "notifications",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 5,
        "x-dead-letter-exchange": "app.dlx",
        "x-dead-letter-routing-key": "notifications"
      }
    },
    {
      "name": "reports",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 5,
        "x-dead-letter-exchange": "app.dlx",
        "x-dead-letter-routing-key": "reports"
      }
    },
    {
      "name": "audit.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "notifications.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "reports.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "app.events",
      "vhost": "/",
      "destination": "audit",
      "destination_type": "queue",
      "routing_key": "audit",
      "arguments": {}
    },
    {
      "source": "app.events",
      "vhost": "/",
      "destination": "notifications",
      "destination_type": "queue",
      "routing_key": "notifications",
      "arguments": {}
    },
    {
      "source": "app.events",
      "vhost": "/",
      "destination": "reports",
      "destination_type": "queue",
      "routing_key": "reports",
      "arguments": {}
    },
    {
      "source": "app.dlx",
      "vhost": "/",
      "destination": "audit.dlq",
      "destination_type": "queue",
      "routing_key": "audit",
      "arguments": {}
    },
    {
      "source": "app.dlx",
      "vhost": "/",
      "destination": "notifications.dlq",
      "destination_type": "queue",
      "routing_key": "notifications",
      "arguments": {}
    },
    {
      "source": "app.dlx",
      "vhost": "/",
      "destination": "reports.dlq",
      "destination_type": "queue",
      "routing_key": "reports",
      "arguments": {}
    }
  ],
  "users": [
    {
      "name": "__USER__",
      "password": "__PASS__",
      "tags": []
    }
  ],
  "permissions": [
    {
      "user": "__USER__",
      "vhost": "/",
      "configure": "^$",
      "write": "^app\\.events$",
      "read": "^(audit|notifications|reports)$"
    }
  ]
}
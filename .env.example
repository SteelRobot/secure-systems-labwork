# Скопируйте в .env и заполните (или выполните ./scripts/init-env.sh – он сгенерирует секреты).
# .env в git не попадает.

# ===== PostgreSQL =====
# Суперпользователь БД. Используется ТОЛЬКО для инициализации схемы и контейнера db-seed.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=support
# Пароль роли app_api (backend API): права только из db/roles.sql
DB_API_PASSWORD=
# Пароль роли app_worker (фоновый обработчик)
DB_WORKER_PASSWORD=

# ===== Redis: сессии, лимиты частоты, ключи идемпотентности, коды сброса пароля =====
REDIS_PASSWORD=

# ===== RabbitMQ: очереди audit / notifications / reports / payments =====
RABBITMQ_USER=app
RABBITMQ_PASSWORD=

# ===== Объектное хранилище (RustFS, S3 API): документы и отчёты =====
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== Backend API =====
# Ключ подписи JWT (HS256), не менее 32 случайных символов
JWT_SECRET=
# Перец для паролей: HMAC-ключ, применяется перед Argon2id. Хранится только в окружении, не в БД
PASSWORD_PEPPER=
# Время жизни токена и сессии в Redis, секунд
ACCESS_TOKEN_TTL_SECONDS=1800
# Срок действия кода восстановления доступа, секунд
PASSWORD_RESET_TTL_SECONDS=900
# Swagger (/docs): только для отладки
API_DOCS_ENABLED=false
LOG_LEVEL=INFO

# ===== Токены доступа к внешним системам-заглушкам (B-11, B-12) =====
FINANCE_API_TOKEN=
MONITORING_API_TOKEN=

# ===== Тестовые данные (db-seed) =====
# Общий пароль тестовых учётных записей. Только для локальной демонстрации.
SEED_PASSWORD=
